# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=2204
DB_NAME=quan_ao_tre_em

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE=7d

# Gemini AI Configuration (Single Key)
# Tạo 1 API key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here
# Or use API_KEY_CHATBOT=your-api-key-here

# Optional Gemini Model
GEMINI_MODEL=gemini-2.0-flash

# Gemini Model Configuration
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_FALLBACK=gemini-1.5-flash,gemini-1.5-pro

# Gemini Retry Configuration
GEMINI_MAX_RETRY_WAIT_MS=5000
GEMINI_429_RETRIES=0
GEMINI_TOTAL_TIMEOUT_MS=50000

